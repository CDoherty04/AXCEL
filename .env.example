QUICKNODE_XRP_RPC_URL=
QUICKNODE_ETH_RPC_URL=

# AP4M agentic payments (integrations/ap4m/) — secrets only in .env.local
AP4M_API_URL=https://hackathon.ap4m.build
TEAM_NAME=
AGENT_PRIVATE_KEY=
CHANNEL_ID=
CHANNEL_CAP=5

# Credit layer (Devnet service). MASTERCARD_MODE=ap4m switches Know Your Agent + authorization to the real AP4M service
# using TEAM_NAME / AGENT_PRIVATE_KEY above. Leave empty for the mock.
MASTERCARD_MODE=
# RLUSD redeemed per credit-layer dollar (a team allocation is small; 0.01 turns $35 into 0.35 RLUSD)
AP4M_AMOUNT_SCALE=0.01
